 "type": {
  "display": {
   "family": "Archivo",
   "weight": 900,
   "transform": "uppercase",
   "tracking": "-0.05em"
  },
  "number": {
   "family": "Archivo Narrow",
   "weight": 700,
   "numeric": "tabular-nums"
  },
  "body": {
   "family": "Archivo",
   "weight": 400
  },
  "serif": {
   "family": "Instrument Serif",
   "weight": 400,
   "use": "manifesto, citação, uma frase por tela"
  }
 },
 "motion": {
  "ease": "cubic-bezier(.2,.8,.2,1)",
  "fast": "120ms",
  "base": "240ms",
  "slow": "700ms",
  "rules": [
   "uma vez por tela",
   "sem zoom de entrada",
   "sem loop",
   "reduzir movimento = crossfade 120ms"
  ]
 },
 "radius": {
  "sm": 8,
  "md": 12,
  "lg": 14,
  "xl": 20
 },
 "space": [
  4,
  8,
  12,
  16,
  24,
  32,
  48
 ],
 "rules": [
  "ember aparece uma vez forte por tela",
  "semáforo é cor de estado, nunca de marca",
  "no máximo três cores por peça fora os neutros",
  "sem gradiente colorido, glow, 3D ou sombra pesada",
  "número com unidade e contexto sempre"
 ]
